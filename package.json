{
  "name": "axonbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "postinstall": "prisma generate",
    "start:stable": "powershell -ExecutionPolicy Bypass -File ./scripts/start-stable.ps1",
    "start:watch": "powershell -ExecutionPolicy Bypass -File ./scripts/start-stable.ps1 -Watch",
    "start:daemon": "powershell -ExecutionPolicy Bypass -File ./scripts/start-daemon.ps1",
    "stop:daemon": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-daemon.ps1",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "5.22.0",
    "@react-pdf/renderer": "^4.5.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "docx": "^9.5.0",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "imapflow": "^1.7.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.27.0",
    "mailparser": "^3.9.15",
    "next": "15.5.22",
    "next-auth": "^4.24.15",
    "openai": "^7.1.0",
    "prisma": "5.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "tsx": "^4.23.1",
    "unpdf": "^1.8.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "playwright": "^1.55.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
