# Local (Docker): docker compose up -d
# Railway: DATABASE_URL is injected from the Postgres plugin.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/axonbox"

NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_MODEL="qwen/qwen3-vl-32b-instruct"

# Inbound mailbox: users forward site emails here.
# Show this address in Inbox. Receiving needs webhook and/or IMAP.
# INBOUND_EMAIL_ADDRESS="inbox@your-company.com"
# INBOUND_WEBHOOK_SECRET="long-random-token"
# Point SendGrid / Mailgun / Cloudflare / Resend inbound to:
#   https://<your-domain>/api/connectors/email/webhook?token=<INBOUND_WEBHOOK_SECRET>
# Resend inbound (preferred): webhook email.received + RESEND_API_KEY
# RESEND_API_KEY="re_..."
# Point Resend webhook to:
#   https://<your-domain>/api/connectors/email/webhook?token=<INBOUND_WEBHOOK_SECRET>
# IMAP (optional fallback):
# IMAP_HOST="imap.gmail.com"
# IMAP_PORT="993"
# IMAP_USER="inbox@your-company.com"
# IMAP_PASSWORD=""
# IMAP_MAILBOX="INBOX"
# EMAIL_AUTO_WORKFLOW="false"

# WhatsApp via YCloud Cloud API. Dedicated intake number (not shown in the app).
# YCLOUD_API_KEY=""
# YCLOUD_WEBHOOK_SECRET=""
# WHATSAPP_DISPLAY_NUMBER="+85253688279"
# Point YCloud webhook (whatsapp.inbound_message.received) to:
#   https://<your-domain>/api/connectors/whatsapp/webhook
# Cantonese voice notes → text for LLM:
# CANTONESE_AI_API_KEY=""

# Optional: Railway Bucket (S3). If unset, files stay on local disk.
# BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL="https://storage.railway.app"
# AWS_REGION="auto"
